# Placeholders only — copy to lambda/.env for local testing (gitignored,
# never committed). In production these are set as real Lambda environment
# variables via `aws lambda update-function-configuration`, never as a file.

TABLE_NAME=myfirstbank-leads
ALLOWED_ORIGIN=https://juanjochiarellar.github.io

# Left empty until the user provides a real key — see README.md "Brevo
# integration". The handler skips all Brevo calls (logs a note, still
# writes the lead to DynamoDB normally) whenever this is empty.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MyFirstBank
BREVO_SMS_SENDER=MyFirstBank
