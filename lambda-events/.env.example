# Placeholders only — copy to lambda-events/.env for local testing (gitignored,
# never committed). In production these are set as real Lambda environment
# variables via `aws lambda update-function-configuration`, never as a file.

EVENTS_TABLE_NAME=myfirstbank-email-events
LEADS_TABLE_NAME=myfirstbank-leads

# Shared secret checked against the `?token=` query param on every incoming
# webhook request. There is no Origin header on a server-to-server webhook
# call, so this — not CORS — is what actually secures this endpoint. Left
# empty here on purpose: an empty WEBHOOK_TOKEN makes the handler reject
# every request (fail closed), never fail open.
WEBHOOK_TOKEN=
