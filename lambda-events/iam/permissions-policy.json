{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBEmailEventsWriteOnly",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:us-east-2:797781631822:table/myfirstbank-email-events"
    },
    {
      "Sid": "DynamoDBLeadReadOnly",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:us-east-2:797781631822:table/myfirstbank-leads"
    },
    {
      "Sid": "OwnLogGroupOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-2:797781631822:log-group:/aws/lambda/myfirstbank-email-events-handler:*"
    }
  ]
}
