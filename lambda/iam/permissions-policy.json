{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBLeadWriteOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:us-east-2:797781631822:table/myfirstbank-leads"
    },
    {
      "Sid": "OwnLogGroupOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-2:797781631822:log-group:/aws/lambda/myfirstbank-leads-handler:*"
    }
  ]
}
